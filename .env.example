# ==============================================================================
# SecureScript WAF Platform — Environment Variables
# Copy this file to .env and fill in your values before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (required for multi-tenant platform)
# For local dev, leave blank to use SQLite (securescript.db will be created)
# For production (Render), use the postgresql+asyncpg:// connection string
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/securescript
# DATABASE_URL=sqlite+aiosqlite:///./securescript.db   # local dev alternative

# ------------------------------------------------------------------------------
# JWT Authentication (required)
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-secret-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Email Alerts via SMTP (optional — leave blank to disable email alerts)
# Works with SendGrid, AWS SES, Mailgun, or any SMTP relay
# SendGrid example: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=<your-api-key>
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key-here
SMTP_FROM=noreply@securescript.app

# ------------------------------------------------------------------------------
# WAF Behaviour
# ------------------------------------------------------------------------------
WAF_MODE=block
# WAF_MODE=audit     # Log but don't block
# WAF_MODE=pass      # Bypass inspection (testing only)

DL_THRESHOLD=0.85    # BiLSTM confidence threshold (0.0–1.0)

# ------------------------------------------------------------------------------
# Legacy Single-Tenant Fallback (optional)
# These are used by the catch-all /{path} route for direct WAF testing.
# Not required if you're using the multi-tenant /proxy/{slug}/ routing.
# ------------------------------------------------------------------------------
UPSTREAM_URL=https://basic-form-project.vercel.app
BACKEND_API_URL=https://basic-form-project.onrender.com
